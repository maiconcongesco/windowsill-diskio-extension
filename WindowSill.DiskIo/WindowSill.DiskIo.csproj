<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WindowSill usa .NET 9 + WinUI3/WASDK -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>

    <!-- Metadados da extensao -->
    <PackageId>WindowSill.DiskIo</PackageId>
    <Version>0.1.0</Version>
    <Authors>maiconcongesco</Authors>
    <Title>Disk I/O</Title>
    <Description>Exibe metricas de leitura/escrita de disco (MB/s) e fila na barra do WindowSill.</Description>
    <PackageTags>windowsill;diskio;monitoring;disk</PackageTags>
    <PackageProjectUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WindowSill.API nao esta no nuget.org.
      Referencia a DLL instalada localmente junto com o WindowSill.
      Caminho padrao apos instalacao via Microsoft Store / MSIX.
      Ajuste o caminho se o WindowSill estiver instalado em local diferente.
    -->
    <Reference Include="WindowSill.API">
      <HintPath>$(LOCALAPPDATA)\Microsoft\WindowsApps\WindowSill.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
