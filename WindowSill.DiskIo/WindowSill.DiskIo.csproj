<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>

    <!-- NuGet / wsext metadata -->
    <PackageId>WindowSill.DiskIo</PackageId>
    <Version>0.1.0</Version>
    <Authors>maiconcongesco</Authors>
    <Description>Disk I/O metrics (Read/Write MB/s, Queue) on the WindowSill bar.</Description>
    <PackageTags>windowsill;diskio;monitoring</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindowSill.Sdk" Version="*" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

</Project>
