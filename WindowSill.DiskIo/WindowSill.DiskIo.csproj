<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0-windows10.0.26100.0 = Windows 11 SDK 26100 (disponivel no NuGet para .NET 10).
      NÃO usar net10.0-windows (resolve para windows7.0 e quebra os PackageReference).
      NÃO usar net10.0-windows10.0.22621.0 (SDK 22621 nao tem Ref pack para .NET 10).
      WindowSill 0.9.21 foi compilado contra .NET 10.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>

    <PackageId>WindowSill.DiskIo</PackageId>
    <Version>0.1.0</Version>
    <Authors>maiconcongesco</Authors>
    <Title>Disk I/O</Title>
    <Description>Exibe metricas de leitura/escrita de disco (MB/s) e fila na barra do WindowSill.</Description>
    <PackageTags>windowsill;diskio;monitoring;disk</PackageTags>
    <PackageProjectUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- MEF moderno (.NET Core / .NET 5+) -->
    <PackageReference Include="System.Composition" Version="10.0.0" />
    <!-- PerformanceCounter nao esta incluido no TFM padrao -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      WindowSill.API.dll instalada localmente via Microsoft Store.
      Caminho real: C:\Program Files\WindowsApps\64360VelerSoftware.WindowSill_0.9.21.0_x64__j80j2txgjg9dj
    -->
    <Reference Include="WindowSill.API">
      <HintPath>C:\Program Files\WindowsApps\64360VelerSoftware.WindowSill_0.9.21.0_x64__j80j2txgjg9dj\WindowSill.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
