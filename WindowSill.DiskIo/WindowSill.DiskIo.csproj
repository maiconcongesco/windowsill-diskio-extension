<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0-windows (sem sufixo de versao do SDK):
      - Nao usa WinUI/XAML/WinRT, entao nao precisa do Windows App SDK completo
      - Compativel com o CI (windows-latest nao tem Microsoft.Build.Packaging.Pri.Tasks)
      - Funciona perfeitamente no WindowSill pois eh pure C# + MEF + PerformanceCounter
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <PackageId>WindowSill.DiskIo</PackageId>
    <Version>0.2.0</Version>
    <Authors>maiconcongesco</Authors>
    <Title>Disk I/O</Title>
    <Description>
      Monitor your disk read/write activity without leaving your flow.
      • Real-time read and write speed (MB/s)
      • Disk queue length
      • All from your sill.
      Works with all local disks on Windows.
    </Description>
    <PackageTags>windowsill;diskio;monitoring;disk</PackageTags>
    <PackageProjectUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- License via arquivo (padrao oficial WindowSill) -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Arquivos obrigatorios no pacote (padrao WindowSill-app/Extensions) -->
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOGS.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MEF moderno -->
    <PackageReference Include="System.Composition" Version="8.0.0" />
    <!-- PerformanceCounter -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- API publica do WindowSill -->
    <PackageReference Include="WindowSill.API" Version="0.9.21" />
  </ItemGroup>

</Project>
