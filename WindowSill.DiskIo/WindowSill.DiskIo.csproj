<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Framework exato suportado pelo WindowSill.API -->
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>

    <!-- Metadados da extensao -->
    <PackageId>WindowSill.DiskIo</PackageId>
    <Version>0.1.0</Version>
    <Authors>maiconcongesco</Authors>
    <Title>Disk I/O</Title>
    <Description>Exibe metricas de leitura/escrita de disco (MB/s) e fila na barra do WindowSill.</Description>
    <PackageTags>windowsill;diskio;monitoring;disk</PackageTags>
    <PackageProjectUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maiconcongesco/windowsill-diskio-extension</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK oficial do WindowSill - versao mais recente -->
    <PackageReference Include="WindowSill.API" Version="0.9.21" />
  </ItemGroup>

</Project>
